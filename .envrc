# direnv 配置文件 - 自动激活虚拟环境
# 使用说明：
# 1. 安装 direnv: brew install direnv (macOS) 或 apt install direnv (Linux)
# 2. 在 shell 配置文件中添加: eval "$(direnv hook bash)" 或 eval "$(direnv hook zsh)"
# 3. 进入项目目录时会自动激活虚拟环境

# 检查虚拟环境是否存在，如果不存在则创建
if [ ! -d ".venv" ]; then
    echo "创建虚拟环境..."
    python3 -m venv .venv
fi

# 激活虚拟环境
source .venv/bin/activate

# 可选：自动安装依赖（如果 requirements.txt 更新了）
# 取消下面的注释以启用自动安装
# if [ -f "requirements.txt" ]; then
#     pip install -q -r requirements.txt
# fi


